{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      // Our own events, and the level the [LoggerMessage] set is written at.
      "Zmg": "Information",
      // Drops the per-request start/finish pair that ACA's ingress log already records better.
      "Microsoft.AspNetCore": "Warning",
      // The exception handler middleware logs the exception at Error *before* calling our handler,
      // which logs it again with its event id and fields — the same stack twice, in adjacent lines,
      // and twice the ingestion. GlobalExceptionHandler always claims the exception, so this loses
      // nothing; a failure inside the handler itself still surfaces through Kestrel.
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None",
      // At Information, EF's command logger alone is the bulk of the ingestion and none of the signal:
      // every SQL statement of every request, including the session lookup each one performs.
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    // A request slower than this earns a line (M57). Not a timeout — nothing is cancelled.
    "SlowRequestMs": 1000
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Auth": {
    "SessionDays": 7,
    "AllowedHosts": [
      "app.zionmusicgroup.com",
      "zmg-tracker.zmg-app.workers.dev",
      "zmg-app.mangohill-c8bd3207.eastus.azurecontainerapps.io"
    ]
  },
  "AllowedHosts": "*"
}
